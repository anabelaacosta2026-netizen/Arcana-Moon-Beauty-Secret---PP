# ===================================================
# ARCANA — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' en tu servidor y completa con tus credenciales reales.
# ===================================================

# Entorno: 'development' o 'production'
APP_ENV=development
APP_DEBUG=true

# Configuración de Base de Datos
DB_DRIVER=json
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arcanaestetica_db
DB_USER=root
DB_PASS=

# Configuración SMTP de Correo (Gmail)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=tls
MAIL_SMTP_USER=tu-correo@gmail.com
MAIL_SMTP_PASS=tu-clave-de-aplicacion-de-16-caracteres
MAIL_FROM_EMAIL=tu-correo@gmail.com
MAIL_FROM_NAME="Arcana — Moon Beauty Secret"

# Credenciales de Mercado Pago por Defecto (Opcional - también se configuran desde el panel web)
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Credenciales de Ualá Bis por Defecto (Opcional)
UALA_PUBLIC_KEY=live_user_pk_000000000000
UALA_ACCESS_TOKEN=live_user_sk_000000000000

# Credenciales de Google OAuth / Sign-In
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Clave de seguridad interna de la aplicación (AES-256)
APP_KEY=tu_clave_secreta_de_cifrado_aes256

